# ---- Supabase (Project Settings -> API) ----
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server only, never expose

# ---- App ----
# Root domain the product runs on. Tenants get <slug>.APP_ROOT_DOMAIN automatically;
# customer domains (hr.customer.com) are mapped in the tenant_domains table.
APP_ROOT_DOMAIN=hrmsuite.in
# Used on localhost / preview URLs where no domain or subdomain identifies the tenant.
# For a single-company deployment (e.g. KMR), set it to that company's slug.
DEFAULT_TENANT_SLUG=demo

# ---- Serving under another site's address (e.g. https://www.kmr-groups.com/it/hrm) ----
# Leave all three empty when the app has its own domain or subdomain.
# Sub-path the app lives under (set BEFORE building; changing it needs a redeploy)
NEXT_PUBLIC_BASE_PATH=
# Full public address, used in emails, WhatsApp, QR codes and for Face ID
APP_PUBLIC_URL=
# Extra site addresses allowed to submit forms, comma separated (APP_PUBLIC_URL's host is added automatically)
ALLOWED_ORIGINS=
# Long random string (32+ chars). Signs passkey challenges and other short-lived cookies.
APP_SECRET=change-me-to-a-long-random-string
# Protects the scheduled reminder endpoint (Vercel Cron sends it as a Bearer token)
CRON_SECRET=change-me-too

# ---- Footer shown on every screen (defaults below; set POWERED_BY_TEXT=off to hide) ----
POWERED_BY_TEXT=KMR Group of Companies
POWERED_BY_URL=https://www.kmr-groups.com

# ---- Email (Resend) ----
RESEND_API_KEY=
# Fallback sender when a tenant has not verified its own domain
EMAIL_FROM=hr@notify.hrmsuite.in

# ---- WhatsApp (Meta WhatsApp Cloud API) ----
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
# "template" (production: pre-approved utility templates) or "text" (testing inside the 24h window)
WHATSAPP_MODE=template
